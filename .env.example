# Runtime Environment
ENVIRONMENT=development
PROJECT_NAME="Enterprise Document Intelligence Platform"

# Storage & Database
DATABASE_URL=sqlite:///./data/doc_intel_hub.db
CHROMA_PERSIST_DIR=./data/chroma_db

# Local Ollama AI Engine
OLLAMA_BASE_URL=http://localhost:11434
GENERATION_MODEL=llama3.2:latest
EMBEDDING_MODEL=bge-m3:latest

# Thresholds & Limits
MIN_PAGE_QUALITY_SCORE=0.65
SIMILARITY_RELEVANCE_THRESHOLD=0.40
TOP_K_CHUNKS=5