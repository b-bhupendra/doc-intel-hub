# Runtime Environment
ENVIRONMENT=development
PROJECT_NAME="Enterprise Document Intelligence Platform"

# --- AI Provider Mode ("offline" | "cloud") ---
AI_MODE=offline

# Storage & Database
DATABASE_URL=sqlite:///./data/doc_intel_hub.db
CHROMA_PERSIST_DIR=./data/chroma_db

# --- Offline AI Engine (Local Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OFFLINE_GENERATION_MODEL=llama3.2:latest
OFFLINE_EMBEDDING_MODEL=bge-m3:latest

# --- Cloud AI Engine (Groq & Cohere) ---
GROQ_API_KEY=your_groq_api_key_here
COHERE_API_KEY=your_cohere_api_key_here
CLOUD_GENERATION_MODEL=llama-3.3-70b-versatile
CLOUD_EMBEDDING_MODEL=embed-multilingual-v3.0

# Thresholds & Limits
MIN_PAGE_QUALITY_SCORE=0.65
SIMILARITY_RELEVANCE_THRESHOLD=0.40
TOP_K_CHUNKS=5